# Copy to .env and change every value before running `docker compose up --build`.

# SQL Server "sa" password - 8+ chars with upper, lower, digit and symbol.
MSSQL_SA_PASSWORD=Change_Me_Str0ng!

# JWT signing key - 32+ random characters. Generate one with: openssl rand -base64 48
JWT_KEY=replace-with-a-long-random-secret-at-least-32-chars

# First admin account (created only when the database has no users).
ADMIN_NAME=Axpense Admin
ADMIN_EMAIL=admin@axpense.net
ADMIN_PASSWORD=Change_Me_Admin1

# URLs
WEB_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=https://api.axpense.net
NEXT_PUBLIC_APP_URL=https://app.axpense.net/login
NEXT_PUBLIC_DEMO_URL=https://app.axpense.net/demo
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
SWAGGER_ENABLED=true

# Optional: also forward website leads to Zapier/Make/CRM
LEADS_WEBHOOK_URL=

# Optional: email every lead/demo request through Resend.
RESEND_API_KEY=
LEADS_EMAIL_TO=Ma7morsy@gmail.com
LEADS_EMAIL_FROM=Axpense <leads@axpense.net>

# --- Marketing site / SEO (Next.js) ---
# Canonical origin used for canonicals, hreflang, sitemap, OG URLs (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://axpense.net
# Google Search Console "HTML tag" token (content value only) -> <meta name="google-site-verification">.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools token -> <meta name="msvalidate.01">.
NEXT_PUBLIC_BING_SITE_VERIFICATION=
# true = 308 axpense-website.vercel.app and www.axpense.net -> axpense.net. Enable ONLY once axpense.net serves this deployment.
ENFORCE_CANONICAL_HOST=false
# Set to false to switch GA/GTM off even when an ID is set (they only load in production builds).
NEXT_PUBLIC_ENABLE_GTM=true
# Optional IndexNow key; if empty, scripts/indexnow.mjs uses the public/<32-hex>.txt key file.
INDEXNOW_KEY=
